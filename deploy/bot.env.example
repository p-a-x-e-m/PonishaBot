# Copy to deploy/bot.env (chmod 600) and fill in. Loaded by systemd.
# This file is gitignored — never commit real values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,YOUR_VPS_IP
# Set to 1 only while debugging; leave 0 in production
DJANGO_DEBUG=0

# Bind address used by `manage.py bot`
BOT_HOST=127.0.0.1
BOT_PORT=8000

# Telegram (overrides config.yaml values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Passphrase for decrypting the pss-at cookie (optional)
PONISHA_TOKEN_PASSPHRASE=
