# Reverse proxy for the ponishabot dashboard.
# The dashboard itself has NO authentication and can read/echo your Telegram
# token and AI key — never expose it without a password in front.
#
#   sudo htpasswd -c /etc/nginx/.htpasswd ponisha
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/ponishabot
#   sudo ln -s /etc/nginx/sites-available/ponishabot /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name YOUR_VPS_IP_OR_DOMAIN;

    auth_basic "ponishabot";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Long-running API calls (start/stop/bid) can take a while
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location /static/ {
        alias /opt/ponishabot/staticfiles/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
