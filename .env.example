# Copy to .env and fill locally.  NEVER commit the filled file.
#
# IMPORTANT: nothing in this project loads a `.env` file. There is no
# python-dotenv dependency and no hand-rolled parser — values are read with
# os.getenv directly from the process environment. So a `.env` here is a
# reminder of what to export, not something the code consumes.
#
#   bash:        export TELEGRAM_BOT_TOKEN=...
#   PowerShell:  $env:TELEGRAM_BOT_TOKEN="..."
#   systemd:     EnvironmentFile=deploy/bot.env   (see deploy/bot.env.example)

# ── Telegram alerts ────────────────────────────────────────────────────
# Both override the same keys in config.yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Django ─────────────────────────────────────────────────────────────
# Long random string. The value in web/settings.py is a local-only placeholder.
DJANGO_SECRET_KEY=
# Keep 1 only while debugging: with DEBUG=0 runserver serves no static files,
# and the dashboard loads unstyled with every button inert (poll.js 404s).
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Dashboard bind address (manage.py bot) ─────────────────────────────
# Anything other than 127.0.0.1 exposes an unauthenticated dashboard that
# serves the Telegram token and AI key in its settings page HTML.
BOT_HOST=127.0.0.1
BOT_PORT=8000

# ── ponisha pss-at passphrase (optional) ───────────────────────────────
# Only needed for the browser-login cookie path. With it unset, use the OTP
# login instead — that path needs no passphrase and no display.
# Do not add a blank line for this one: an empty value is not the same as an
# unset one (an empty passphrase encrypts the cookie with no key, and the
# site then rejects it). Leave it commented until you have a real value.
# PONISHA_TOKEN_PASSPHRASE=
